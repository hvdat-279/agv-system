<?xml version="1.0"?>
<robot name="agv"
    xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="controller_config" default=""/>
    <xacro:include filename="materials.urdf.xacro"/>
    <xacro:include filename="base.urdf.xacro"/>
    <xacro:include filename="wheels.urdf.xacro"/>
    <xacro:include filename="sensors.urdf.xacro"/>
    <xacro:include filename="agv.ros2_control.xacro"/>

    <xacro:agv_ros2_control controller_config="$(arg controller_config)"/>

    <!-- Joints for wheels -->
    <joint name="base_to_left_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="-0.15 0.2 0.0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_to_right_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="-0.15 -0.2 0.0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- Forklift mast (fixed) -->
    <link name="mast_link">
        <visual>
            <geometry>
                <box size="0.05 0.25 0.6"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0 0.3"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.05 0.25 0.6"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0 0.3"/>
        </collision>
        <inertial>
            <mass value="3.0"/>
            <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
        </inertial>
    </link>

    <joint name="base_to_mast" type="fixed">
        <parent link="base_link"/>
        <child link="mast_link"/>
        <origin xyz="0.23 0 0.05" rpy="0 0 0"/>
    </joint>

    <!-- Fork carriage (prismatic lift) -->
    <link name="fork_link">
        <visual>
            <geometry>
                <box size="0.35 0.04 0.02"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0.17 0.08 0.01"/>
            <material name="black"/>
        </visual>
        <visual>
            <geometry>
                <box size="0.35 0.04 0.02"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0.17 -0.08 0.01"/>
            <material name="black"/>
        </visual>
        <inertial>
            <mass value="2.0"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="base_to_fork_lift" type="prismatic">
        <parent link="base_link"/>
        <child link="fork_link"/>
        <origin xyz="0.2 0 0.02" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0.0" upper="0.35" effort="500.0" velocity="0.15"/>
    </joint>

    <link name="fork_tip"/>
    <joint name="fork_to_tip" type="fixed">
        <parent link="fork_link"/>
        <child link="fork_tip"/>
        <origin xyz="0.35 0 0.02" rpy="0 0 0"/>
    </joint>



    <!-- Joints for caster wheels -->
    <joint name="base_to_caster_front" type="continuous">
        <parent link="base_link"/>
        <child link="caster_front"/>
        <origin xyz="0.2 0 -0.07" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_to_caster_rear" type="continuous">
        <parent link="base_link"/>
        <child link="caster_rear"/>
        <origin xyz="-0.2 0 -0.07" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- Joints for sensors -->
    <joint name="base_to_lidar" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0.2 0 0.15" rpy="0 0 0"/>
    </joint>

    <joint name="base_to_camera" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="0.28 0 0.40" rpy="0 0 0"/>
    </joint>

    <!-- Gazebo DetachableJoint plugins for picking up cargo -->
    <gazebo>
        <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
            <parent_link>fork_link</parent_link>
            <child_model>cargo_red_1</child_model>
            <child_model_link>link</child_model_link>
            <detach_topic>/model/agv/detach_red</detach_topic>
            <attach_topic>/model/agv/attach_red</attach_topic>
        </plugin>
        <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
            <parent_link>fork_link</parent_link>
            <child_model>cargo_blue_1</child_model>
            <child_model_link>link</child_model_link>
            <detach_topic>/model/agv/detach_blue</detach_topic>
            <attach_topic>/model/agv/attach_blue</attach_topic>
        </plugin>
        <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
            <parent_link>fork_link</parent_link>
            <child_model>cargo_yellow_1</child_model>
            <child_model_link>link</child_model_link>
            <detach_topic>/model/agv/detach_yellow</detach_topic>
            <attach_topic>/model/agv/attach_yellow</attach_topic>
        </plugin>
    </gazebo>
</robot>