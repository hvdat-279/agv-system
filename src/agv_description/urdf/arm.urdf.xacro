<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Shoulder link -->
    <link name="shoulder_link">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.2"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.1 0.1 0.2"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>

    <!-- Upper arm link -->
    <link name="upper_arm_link">
        <visual>
            <geometry>
                <box size="0.05 0.05 0.3"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0 0.15"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.05 0.05 0.3"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.3"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>

    <!-- Forearm link -->
    <link name="forearm_link">
        <visual>
            <geometry>
                <box size="0.05 0.05 0.3"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0 0.15"/>
            <material name="green"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.05 0.05 0.3"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.3"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>

    <!-- Wrist link -->
    <link name="wrist_link">
        <visual>
            <geometry>
                <box size="0.04 0.04 0.1"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0 0.05"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.04 0.04 0.1"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
        </inertial>
    </link>

    <!-- Gripper -->
    <link name="gripper_base">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.05"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.1 0.1 0.05"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>

    <link name="gripper_left">
        <visual>
            <geometry>
                <box size="0.02 0.05 0.1"/>
            </geometry>
            <origin rpy="0 0 0" xyz="-0.04 0 0.05"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.05 0.1"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

    <link name="gripper_right">
        <visual>
            <geometry>
                <box size="0.02 0.05 0.1"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0.04 0 0.05"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.05 0.1"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>
</robot>