<?xml version="1.0"?>
<sdf version="1.6">
    <model name="shelf">
        <static>true</static>
        <link name="shelf_link">
            <pose>0 0 0 0 0 0</pose>

            <!-- Legs (Wider spacing: y = +/- 0.35) -->
            <visual name="leg_fl">
                <pose>0.45 0.35 0.5 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.05 0.05 1.0</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.6 0.6 0.6 1</ambient>
                    <diffuse>0.6 0.6 0.6 1</diffuse>
                </material>
            </visual>
            <collision name="leg_fl_collision">
                <pose>0.45 0.35 0.5 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.05 0.05 1.0</size>
                    </box>
                </geometry>
            </collision>

            <visual name="leg_fr">
                <pose>0.45 -0.35 0.5 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.05 0.05 1.0</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.6 0.6 0.6 1</ambient>
                    <diffuse>0.6 0.6 0.6 1</diffuse>
                </material>
            </visual>
            <collision name="leg_fr_collision">
                <pose>0.45 -0.35 0.5 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.05 0.05 1.0</size>
                    </box>
                </geometry>
            </collision>

            <visual name="leg_rl">
                <pose>-0.45 0.35 0.5 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.05 0.05 1.0</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.6 0.6 0.6 1</ambient>
                    <diffuse>0.6 0.6 0.6 1</diffuse>
                </material>
            </visual>
            <collision name="leg_rl_collision">
                <pose>-0.45 0.35 0.5 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.05 0.05 1.0</size>
                    </box>
                </geometry>
            </collision>

            <visual name="leg_rr">
                <pose>-0.45 -0.35 0.5 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.05 0.05 1.0</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.6 0.6 0.6 1</ambient>
                    <diffuse>0.6 0.6 0.6 1</diffuse>
                </material>
            </visual>
            <collision name="leg_rr_collision">
                <pose>-0.45 -0.35 0.5 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.05 0.05 1.0</size>
                    </box>
                </geometry>
            </collision>

            <!-- Shelves (Wider width: y size = 0.74 to span the legs) -->
            <!-- Lowest shelf raised to z = 0.30 for robot base clearance -->
            <visual name="shelf_low">
                <pose>0 0 0.30 0 0 0</pose>
                <geometry>
                    <box>
                        <size>1.0 0.74 0.04</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.7 0.7 0.7 1</ambient>
                    <diffuse>0.7 0.7 0.7 1</diffuse>
                </material>
            </visual>
            <collision name="shelf_low_collision">
                <pose>0 0 0.30 0 0 0</pose>
                <geometry>
                    <box>
                        <size>1.0 0.74 0.04</size>
                    </box>
                </geometry>
            </collision>

            <visual name="shelf_mid">
                <pose>0 0 0.60 0 0 0</pose>
                <geometry>
                    <box>
                        <size>1.0 0.74 0.04</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.7 0.7 0.7 1</ambient>
                    <diffuse>0.7 0.7 0.7 1</diffuse>
                </material>
            </visual>
            <collision name="shelf_mid_collision">
                <pose>0 0 0.60 0 0 0</pose>
                <geometry>
                    <box>
                        <size>1.0 0.74 0.04</size>
                    </box>
                </geometry>
            </collision>

            <visual name="shelf_top">
                <pose>0 0 0.90 0 0 0</pose>
                <geometry>
                    <box>
                        <size>1.0 0.74 0.04</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.7 0.7 0.7 1</ambient>
                    <diffuse>0.7 0.7 0.7 1</diffuse>
                </material>
            </visual>
            <collision name="shelf_top_collision">
                <pose>0 0 0.90 0 0 0</pose>
                <geometry>
