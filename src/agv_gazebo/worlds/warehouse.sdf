<?xml version="1.0"?>
<sdf version="1.6">
    <world name="warehouse">
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>

        <light name="sun" type="directional">
            <pose>0 0 10 0 0 0</pose>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.5 -1</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>20 20</size>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>20 20</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="wall_north">
            <static>true</static>
            <pose>0 4 1 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>8 0.1 2</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>8 0.1 2</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.7 0.7 0.7 1</ambient>
                        <diffuse>0.7 0.7 0.7 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="wall_south">
            <static>true</static>
            <pose>0 -4 1 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>8 0.1 2</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>8 0.1 2</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.7 0.7 0.7 1</ambient>
                        <diffuse>0.7 0.7 0.7 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="wall_east">
            <static>true</static>
            <pose>4 0 1 0 0 1.5708</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>8 0.1 2</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>8 0.1 2</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.7 0.7 0.7 1</ambient>
                        <diffuse>0.7 0.7 0.7 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="wall_west">
            <static>true</static>
            <pose>-4 0 1 0 0 1.5708</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>8 0.1 2</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>8 0.1 2</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.7 0.7 0.7 1</ambient>
                        <diffuse>0.7 0.7 0.7 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Shelves for pickup -->
        <include>
            <uri>model://shelf</uri>
            <name>shelf_red</name>
            <pose>-2 -2 0 0 0 0</pose>
        </include>
        <include>
            <uri>model://shelf</uri>
            <name>shelf_blue</name>
            <pose>2 -2 0 0 0 0</pose>
        </include>
        <include>
            <uri>model://shelf</uri>
            <name>shelf_yellow</name>
            <pose>0 2 0 0 0 0</pose>
        </include>

        <!-- Cargo boxes on tables -->
        <include>
            <uri>model://cargo_red</uri>
            <name>cargo_red_1</name>
            <pose>-2 -2 0.32 0 0 0</pose>
        </include>
        <include>
            <uri>model://cargo_blue</uri>
            <name>cargo_blue_1</name>
            <pose>2 -2 0.32 0 0 0</pose>
        </include>
        <include>
            <uri>model://cargo_yellow</uri>
            <name>cargo_yellow_1</name>
            <pose>0 2 0.32 0 0 0</pose>
        </include>

        <model name="sorting_station_red">
            <static>true</static>
            <pose>3 3 0.05 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.6 0.6 0.1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.6 0.6 0.1</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.8 0.0 0.0 1</ambient>
                        <diffuse>0.8 0.0 0.0 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="sorting_station_blue">
            <static>true</static>
            <pose>-3 3 0.05 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.6 0.6 0.1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.6 0.6 0.1</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.0 0.2 0.8 1</ambient>
                        <diffuse>0.0 0.2 0.8 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="sorting_station_yellow">
            <static>true</static>
            <pose>0 -3 0.05 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.6 0.6 0.1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.6 0.6 0.1</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.0 1</ambient>
                        <diffuse>0.8 0.8 0.0 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
    </world>
</sdf>
